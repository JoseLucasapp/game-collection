import "../vendor/zumbra/std/desktop.zum" as desktop;
import "../vendor/zumbra/std/ui.zum" as ui;

var application << desktop.app({"backend": "headless", "quitOnLastWindow": false});
var window << application.window({"title": "Layout test", "width": 640, "height": 220});

var card << ui.containerWith({
    "id": "game-card",
    "border": true,
    "paddingLeft": 10,
    "paddingRight": 10,
    "paddingTop": 4,
    "paddingBottom": 8,
    "height": 72,
    "minHeight": 72
}, [
    ui.rowWith({
        "id": "game-card-row",
        "gap": 10,
        "align": "center",
        "height": 60,
        "minHeight": 60
    }, [
        ui.columnWith({
            "id": "game-card-copy",
            "gap": 0,
            "grow": 1,
            "height": 44,
            "minHeight": 44,
            "justify": "start"
        }, [
            ui.textWith("Final Fantasy IX", {
                "id": "game-card-title",
                "fontSize": 17,
                "fontWeight": "bold",
                "height": 24,
                "minHeight": 24
            }),
            ui.textWith("PS1 • Final Fantasy", {
                "id": "game-card-meta",
                "fontSize": 13,
                "color": "muted",
                "height": 20,
                "minHeight": 20
            })
        ]),
        ui.buttonWith({"id": "edit", "text": "Editar", "width": 74, "minWidth": 74, "height": 36, "minHeight": 36}),
        ui.buttonWith({"id": "delete", "text": "Excluir", "width": 74, "minWidth": 74, "height": 36, "minHeight": 36})
    ])
]);

var root << ui.columnWith({"id": "game-list", "gap": 8, "height": 72, "overflowY": "auto"}, [card]);
var context << ui.mount(application, window, root, {});
var snapshot << ui.snapshot(context);
var items << snapshot["items"];
show(items[1]["height"]);
show(items[4]["y"] - items[1]["y"]);
show(items[5]["y"] - items[1]["y"]);
show(items[6]["y"] - items[1]["y"]);
context.close();
application.close();
