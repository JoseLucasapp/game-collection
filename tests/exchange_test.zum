import "../src/storage.zum" as storage;
import "../src/exchange.zum" as exchange;
fct game(name, platform, price, description, link, rating) { {"name": name, "platform": platform, "franchise": "", "region": "", "media": "Digital", "condition": "Novo", "cover_path": "", "price": price, "description": description, "link": link, "rating": rating}; }
var source << storage.open(":memory:");
storage.create(source, game("Chrono Trigger", "PC", "R$ 50", "RPG", "https://example.com", "10"));
var jsonPath << "/tmp/zumbra-z16-collection-v2.json"; var csvPath << "/tmp/zumbra-z16-collection-v2.csv";
show(exchange.exportJson(source, jsonPath)["ok"]); show(exchange.exportCsv(source, csvPath)["ok"]);
var jsonTarget << storage.open(":memory:"); show(exchange.importJson(jsonTarget, jsonPath)["ok"]); show(storage.find(jsonTarget, 1)["description"]); show(storage.find(jsonTarget, 1)["rating"]);
var csvTarget << storage.open(":memory:"); show(exchange.importCsv(csvTarget, csvPath)["ok"]); show(storage.find(csvTarget, 1)["price"]); show(storage.find(csvTarget, 1)["link"]);
show(storage.close(source)); show(storage.close(jsonTarget)); show(storage.close(csvTarget));
