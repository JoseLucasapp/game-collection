var actionEvents << {};
var dispatchAction << fct(event) {
    application.emit({"type": actionEvents[event["targetId"]], "data": {}});
};

fct actionButton(id, text, eventName, width) {
    actionEvents[id] << eventName;
    ui.buttonWith({
        "id": id,
        "text": text,
        "width": width,
        "minWidth": width,
        "height": 36,
        "minHeight": 36,
        "accessibilityLabel": text,
        "cursor": "pointer",
        "onClick": dispatchAction
    });
}

fct iconActionButton(id, icon, labelText, eventName, width) {
    actionEvents[id] << eventName;
    ui.buttonWith({
        "id": id,
        "text": "",
        "icon": icon,
        "width": width,
        "minWidth": width,
        "height": 36,
        "minHeight": 36,
        "accessibilityLabel": labelText,
        "cursor": "pointer",
        "focusInset": 2,
        "onClick": dispatchAction
    });
}

fct modalHeader(title, closeId, closeEvent) {
    ui.rowWith({"align": "center", "gap": 12, "height": 40, "minHeight": 40}, [
        ui.containerWith({"grow": 1, "height": 40, "minHeight": 40, "align": "start", "justify": "center"}, [
            ui.textWith(title, {"fontSize": 22, "fontWeight": "bold", "height": 40, "minHeight": 40})
        ]),
        iconActionButton(closeId, "close", "Fechar", closeEvent, 38)
    ]);
}

fct statRow(labelText, valueText) {
    ui.rowWith({"align": "center", "height": 30, "minHeight": 30}, [
        ui.textWith(labelText, {"fontSize": 13, "fontWeight": "bold"}),
        ui.spacer(1),
        valueText
    ]);
}

fct detailRow(labelText, valueText) {
    ui.rowWith({"align": "center", "gap": 12, "height": 30, "minHeight": 30, "overflow": "hidden"}, [
        ui.textWith(labelText, {"fontSize": 13, "fontWeight": "bold", "width": 92, "minWidth": 92, "height": 24, "minHeight": 24}),
        ui.containerWith({"grow": 1, "height": 24, "minHeight": 24, "overflow": "hidden", "justify": "center"}, [valueText])
    ]);
}

fct detailsValue(value, fallback) {
    if (sizeOf(value) == 0) { return fallback; }
    value;
}

fct label(text) {
    ui.containerWith({"height": 20, "minHeight": 20}, [ui.textWith(text, {"fontSize": 12, "fontWeight": "bold"})]);
}

fct filterValue(value, allLabel) {
    if (value == allLabel) { return ""; }
    value;
}

fct hasOption(options, selected) {
    for option in options {
        if (option == selected) { return true; }
    }
    false;
}

fct pickedPath(options) {
    var selected << desktop.pickFile(application, options);
    if (sizeOf(selected) == 0) { return ""; }
    selected[0];
}

fct importMessage(result) {
    if (result["ok"]) {
        return toString(result["imported"]) + " importados, " + toString(result["skipped"]) + " duplicados ignorados e " + toString(result["invalid"]) + " inválidos";
    }
    "Falha na importação: " + result["error"];
}

