    ui.rowWith({"gap": 8, "height": 40, "minHeight": 40}, [coverPathInput, actionButton("select-cover", "Escolher", "collection_pick_cover", 88)]),
    ui.spacer(4),
    ui.rowWith({"gap": 10, "height": 40, "minHeight": 40}, [
        actionButton("clear-game", "Limpar", "collection_clear", 139),
        actionButton("save-game", "Salvar jogo", "collection_save", 149)
    ]),
    ui.containerWith({"border": true, "padding": 10, "height": 146, "minHeight": 146}, [
        ui.columnWith({"gap": 5}, [
            ui.textWith("Atalhos", {"fontSize": 13, "fontWeight": "bold"}),
            ui.textWith("Ctrl+N  Novo • Ctrl+S  Salvar", {"fontSize": 12}),
            ui.textWith("Ctrl+F  Buscar • Ctrl+D  Dados", {"fontSize": 12}),
            ui.textWith("Ctrl+T  Estatísticas", {"fontSize": 12}),
            ui.textWith("Tab / Shift+Tab  Navegar", {"fontSize": 12}),
            ui.textWith("Esc  Fechar diálogo", {"fontSize": 12})
        ])
    ])
]);
var collapsedSidebarContent << ui.columnWith({"align": "center", "gap": 12, "grow": 1}, [
    actionButton("expand-sidebar", "›", "collection_expand_sidebar", 38),
    ui.containerWith({"height": 120, "minHeight": 120, "align": "center"}, [
        ui.textWith("Jogos", {"fontSize": 13, "fontWeight": "bold"})
    ])
]);
ui.bind(expandedSidebarContent, "visible", sidebarExpandedVisibleState);
ui.bind(collapsedSidebarContent, "visible", sidebarCollapsedVisibleState);

