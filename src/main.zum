                ])
            ])
        ]),
        label("Principais plataformas"),
        ui.rowWith({"gap": 12, "grow": 1, "minHeight": 260}, [
            ui.containerWith({"border": true, "padding": 10, "grow": 1, "minWidth": 360}, [statsPlatformChart]),
            ui.containerWith({"border": true, "padding": 0, "width": 330, "minWidth": 330}, [statsPlatformTable])
        ])
    ])
]);
