    "minWidth": 180,
    "height": 40,
    "minHeight": 40,
    "accessibilityLabel": "Filtrar por franquia"
});
var darkToggle << ui.checkbox({"id": "dark-mode", "text": "Modo escuro", "checked": loadedPreferences["dark_mode"], "accessibilityLabel": "Alternar modo escuro"});

ui.bind(nameInput, "value", nameState);
ui.bind(platformInput, "value", platformState);
ui.bind(franchiseInput, "value", franchiseState);
ui.bind(regionInput, "value", regionState);
ui.bind(mediaSelect, "value", mediaState);
ui.bind(conditionSelect, "value", conditionState);
ui.bind(coverPathInput, "value", coverPathState);
ui.bind(searchInput, "value", searchState);
ui.bind(sortSelect, "value", sortState);
ui.bind(platformFilterSelect, "value", platformFilterState);
ui.bind(franchiseFilterSelect, "value", franchiseFilterState);
ui.bind(darkToggle, "checked", darkModeState);

var statusText << ui.text("");
var countText << ui.text("");
var pendingDeleteText << ui.text("");
var pendingRestoreText << ui.text("");
var coverPreviewNameText << ui.text("");
var coverPreviewImage << ui.image({"id": "cover-preview-image", "path": "", "fit": "contain", "grow": 1, "minHeight": 360, "accessibilityLabel": "Pré-visualização da capa"});
var statsTotalText << ui.text("");
var statsPlatformCountText << ui.text("");
var statsFranchiseCountText << ui.text("");
var statsMediaText << ui.text("");
var statsCoverCountText << ui.text("");
ui.bind(statusText, "text", statusState);
ui.bind(countText, "text", countState);
ui.bind(pendingDeleteText, "text", pendingDeleteName);
ui.bind(pendingRestoreText, "text", pendingRestorePath);
ui.bind(coverPreviewNameText, "text", coverPreviewNameState);
ui.bind(coverPreviewImage, "path", coverPreviewPathState);
ui.bind(statsTotalText, "text", statsTotalState);
ui.bind(statsPlatformCountText, "text", statsPlatformCountState);
ui.bind(statsFranchiseCountText, "text", statsFranchiseCountState);
ui.bind(statsMediaText, "text", statsMediaState);
ui.bind(statsCoverCountText, "text", statsCoverCountState);

var actionEvents << {};
var dispatchAction << fct(event) {
    application.emit({"type": actionEvents[event["targetId"]], "data": {}});
};

fct actionButton(id, text, eventName, width) {
    actionEvents[id] << eventName;
    ui.buttonWith({
        "id": id,
        "text": text,
        "width": width,
        "minWidth": width,
        "height": 36,
        "minHeight": 36,
        "accessibilityLabel": text,
        "onClick": dispatchAction
    });
}

fct modalHeader(title, closeId, closeEvent) {
    ui.rowWith({"align": "center", "gap": 10, "height": 40, "minHeight": 40}, [
        ui.containerWith({"grow": 1, "height": 40, "minHeight": 40}, [
            ui.textWith(title, {"fontSize": 22, "fontWeight": "bold", "height": 40, "minHeight": 40})
        ]),
        actionButton(closeId, "×", closeEvent, 38)
    ]);
}

fct statRow(labelText, valueText) {
    ui.rowWith({"align": "center", "height": 30, "minHeight": 30}, [
        ui.textWith(labelText, {"fontSize": 13, "fontWeight": "bold"}),
        ui.spacer(1),
        valueText
    ]);
}

fct label(text) {
    ui.containerWith({"height": 20, "minHeight": 20}, [ui.textWith(text, {"fontSize": 12, "fontWeight": "bold"})]);
}

fct filterValue(value, allLabel) {
    if (value == allLabel) { return ""; }
    value;
}

fct hasOption(options, selected) {
    for option in options {
        if (option == selected) { return true; }
    }
    false;
}

fct pickedPath(options) {
    var selected << desktop.pickFile(application, options);
    if (sizeOf(selected) == 0) { return ""; }
    selected[0];
}

fct importMessage(result) {
    if (result["ok"]) {
        return toString(result["imported"]) + " importados, " + toString(result["skipped"]) + " duplicados ignorados e " + toString(result["invalid"]) + " inválidos";
    }
    "Falha na importação: " + result["error"];
}

var gameList << ui.columnWith({
    "id": "game-list",
    "gap": 8,
    "grow": 1,
    "overflowY": "auto",
    "scrollStep": 116,
    "scrollbarWidth": 8,
    "scrollbarGutter": 4,
    "paddingRight": 12
}, []);
var currentGames << storage.list(db, "", loadedPreferences["sort"], "", "");
var editTargets << {};
var deleteTargets << {};
var coverTargets << {};

var expandedSidebarContent << ui.columnWith({"gap": 8, "grow": 1, "overflowY": "auto", "scrollStep": 64, "scrollbarWidth": 8, "paddingRight": 10}, [
    ui.rowWith({"align": "center", "gap": 8, "height": 38, "minHeight": 38}, [
        ui.containerWith({"grow": 1, "height": 38, "minHeight": 38}, [ui.textWith("Cadastrar jogo", {"fontSize": 21, "fontWeight": "bold"})]),
        actionButton("collapse-sidebar", "‹", "collection_collapse_sidebar", 38)
    ]),
    ui.containerWith({"height": 24, "minHeight": 24}, [ui.textWith("Adicione ou edite um item da coleção.", {"fontSize": 12, "color": "muted"})]),
