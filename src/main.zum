        ui.spacer(1),
        ui.textWith("SQLite local • dados sob seu controle", {"fontSize": 12, "color": "muted"})
    ])
]);

var statsMediaChart << ui.chart({"id": "stats-media-chart", "height": 190, "minHeight": 190, "background": "transparent", "accessibilityLabel": "Gráfico de mídia física e digital"});
