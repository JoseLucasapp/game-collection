    ]),
    ui.containerWith({"height": 24, "minHeight": 24}, [ui.textWith("Organize sua biblioteca física e digital com dados locais.", {"fontSize": 13, "color": "muted"})]),
    ui.rowWith({"gap": 8, "align": "center", "height": 40, "minHeight": 40}, [searchInput, sortSelect]),
    ui.rowWith({"gap": 8, "align": "center", "height": 40, "minHeight": 40}, [
        platformFilterSelect,
