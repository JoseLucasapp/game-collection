        actionButton("collection-stats", "Estatísticas", "collection_open_stats", 114)
    ]),
    ui.containerWith({"border": true, "padding": 12, "grow": 1, "minHeight": 260}, [gameList]),
    ui.rowWith({"align": "center", "gap": 8, "height": 28, "minHeight": 28}, [
