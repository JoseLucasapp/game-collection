import "../vendor/zumbra/std/desktop.zum" as desktop;
import "../vendor/zumbra/std/ui.zum" as ui;
import "storage.zum" as storage;
import "exchange.zum" as exchange;
import "preferences.zum" as preferences;

var application << desktop.app({
    "backend": "auto",
    "name": "Minha Coleção de Jogos",
    "version": "0.2.2",
    "identifier": "dev.zumbra.gamecollection",
    "quitOnLastWindow": true,
    "closeOnRequest": true
});

var paths << application.paths();
var databasePath << paths["data"] + "/zumbra-game-collection.sqlite";
var preferencesPath << paths["config"] + "/preferences.json";
var loadedPreferences << preferences.load(preferencesPath);
var db << storage.open(databasePath);
var headlessMode << application.backend() == "headless";

var initialPlatformFilter << loadedPreferences["platform_filter"];
if (sizeOf(initialPlatformFilter) == 0) { initialPlatformFilter << "Todas as plataformas"; }
var initialFranchiseFilter << loadedPreferences["franchise_filter"];
if (sizeOf(initialFranchiseFilter) == 0) { initialFranchiseFilter << "Todas as franquias"; }

var window << application.window({
    "title": "Minha Coleção de Jogos",
    "width": 1180,
    "height": 800,
    "minWidth": 1024,
    "minHeight": 650,
    "resizable": true,
    "highDPI": true
});

var editingId << ui.intState(0);
var nameState << ui.stringState("");
var platformState << ui.stringState("");
var franchiseState << ui.stringState("");
var regionState << ui.stringState("");
var mediaState << ui.stringState("Física");
var conditionState << ui.stringState("Usado");
var coverPathState << ui.stringState("");
var searchState << ui.stringState("");
var sortState << ui.stringState(loadedPreferences["sort"]);
var platformFilterState << ui.stringState(initialPlatformFilter);
var franchiseFilterState << ui.stringState(initialFranchiseFilter);
var darkModeState << ui.boolState(loadedPreferences["dark_mode"]);
var statusState << ui.stringState("Coleção carregada");
var countState << ui.stringState("0 jogos");
var deleteModalState << ui.boolState(false);
var dataModalState << ui.boolState(false);
var restoreModalState << ui.boolState(false);
var statsModalState << ui.boolState(false);
var coverModalState << ui.boolState(false);
var sidebarCollapsedState << ui.boolState(false);
var sidebarExpandedVisibleState << ui.boolState(true);
var sidebarCollapsedVisibleState << ui.boolState(false);
var pendingDeleteId << ui.intState(0);
var pendingDeleteName << ui.stringState("");
var pendingRestorePath << ui.stringState("");
var coverPreviewNameState << ui.stringState("");
var coverPreviewPathState << ui.stringState("");
var statsTotalState << ui.stringState("0");
var statsPlatformCountState << ui.stringState("0");
var statsFranchiseCountState << ui.stringState("0");
var statsMediaState << ui.stringState("Física: 0 • Digital: 0");
var statsCoverCountState << ui.stringState("0");

var nameInput << ui.input({"id": "game-name", "placeholder": "Nome do jogo", "height": 40, "minHeight": 40, "accessibilityLabel": "Nome do jogo"});
var platformInput << ui.input({"id": "game-platform", "placeholder": "Ex.: PlayStation 2", "height": 40, "minHeight": 40, "accessibilityLabel": "Plataforma"});
var franchiseInput << ui.input({"id": "game-franchise", "placeholder": "Ex.: Final Fantasy", "height": 40, "minHeight": 40, "accessibilityLabel": "Franquia"});
var regionInput << ui.input({"id": "game-region", "placeholder": "Ex.: NTSC-U, PAL ou Japão", "height": 40, "minHeight": 40, "accessibilityLabel": "Região"});
var mediaSelect << ui.select({
    "id": "game-media",
    "options": ["Física", "Digital", "Física e digital"],
    "value": "Física",
    "height": 40,
    "minHeight": 40,
    "accessibilityLabel": "Tipo de mídia"
});
var conditionSelect << ui.select({
    "id": "game-condition",
    "options": ["Usado", "Novo", "Lacrado", "Completo", "Incompleto"],
    "value": "Usado",
    "height": 40,
    "minHeight": 40,
    "accessibilityLabel": "Condição"
});
var coverPathInput << ui.input({"id": "game-cover", "placeholder": "Caminho de uma imagem local", "grow": 1, "height": 40, "minHeight": 40, "accessibilityLabel": "Capa local"});
var searchInput << ui.input({"id": "game-search", "placeholder": "Buscar nome, plataforma, franquia ou detalhes", "grow": 1, "height": 40, "minHeight": 40, "accessibilityLabel": "Buscar jogos"});
var sortSelect << ui.select({
    "id": "game-sort",
    "options": ["Nome A-Z", "Nome Z-A", "Plataforma A-Z", "Franquia A-Z", "Mais recentes"],
    "value": loadedPreferences["sort"],
    "width": 182,
    "minWidth": 182,
    "height": 40,
    "minHeight": 40,
    "accessibilityLabel": "Ordenação"
});
var platformFilterSelect << ui.select({
    "id": "platform-filter",
    "options": ["Todas as plataformas"],
    "value": initialPlatformFilter,
    "width": 180,
    "minWidth": 180,
    "height": 40,
    "minHeight": 40,
    "accessibilityLabel": "Filtrar por plataforma"
});
var franchiseFilterSelect << ui.select({
    "id": "franchise-filter",
