}, [
    ui.columnWith({"gap": 12, "grow": 1}, [
        modalHeader("Capa do jogo", "close-cover-x", "collection_close_cover"),
        ui.containerWith({"height": 28, "minHeight": 28}, [coverPreviewNameText]),
        ui.containerWith({"border": true, "padding": 12, "grow": 1, "minHeight": 440}, [coverPreviewImage]),
        ui.rowWith({"height": 40, "minHeight": 40}, [
            ui.spacer(1),
            actionButton("open-cover-external", "Abrir externamente", "collection_open_cover_external", 160)
        ])
    ])
]);
ui.bind(coverModal, "visible", coverModalState);

var mainLayout << ui.rowWith({"padding": 18, "gap": 18, "grow": 1}, [sidebar, collectionPanel]);
var root << ui.containerWith({"grow": 1}, [mainLayout, deleteModal, dataModal, restoreModal, statsModal, coverModal]);
var initialTheme << "light";
if (loadedPreferences["dark_mode"]) { initialTheme << "dark"; }
var context << ui.mount(application, window, root, {"theme": ui.theme(initialTheme)});

var notify << fct(message, urgency) {
    desktop.notify(application, {"title": "Minha Coleção de Jogos", "body": message, "urgency": urgency});
};

var savePreferences << fct() {
    preferences.save(preferencesPath, {
        "dark_mode": darkModeState.get(),
        "sort": sortState.get(),
        "platform_filter": filterValue(platformFilterState.get(), "Todas as plataformas"),
        "franchise_filter": filterValue(franchiseFilterState.get(), "Todas as franquias")
    });
};

var clearForm << fct() {
    editingId.set(0);
    nameState.set("");
    platformState.set("");
    franchiseState.set("");
    regionState.set("");
    mediaState.set("Física");
    conditionState.set("Usado");
    coverPathState.set("");
    statusState.set("Novo jogo");
    context.focus(nameInput);
};

var requestRefresh << fct() {
    application.emit({"type": "collection_refresh", "data": {}});
};

var saveGame << fct() {
    var game << {
        "name": nameState.get(),
        "platform": platformState.get(),
        "franchise": franchiseState.get(),
        "region": regionState.get(),
        "media": mediaState.get(),
        "condition": conditionState.get(),
        "cover_path": coverPathState.get()
    };
    if (sizeOf(game["name"]) == 0) {
        statusState.set("Informe o nome do jogo");
        context.focus(nameInput);
        return false;
    }
    if (sizeOf(game["platform"]) == 0) {
        statusState.set("Informe a plataforma");
        context.focus(platformInput);
        return false;
    }
    var currentId << editingId.get();
    if (currentId > 0) {
        storage.update(db, currentId, game);
        statusState.set("Jogo atualizado");
        notify(game["name"] + " foi atualizado", "normal");
    } else {
        storage.create(db, game);
        statusState.set("Jogo adicionado à coleção");
        notify(game["name"] + " foi adicionado", "normal");
    }
    editingId.set(0);
    nameState.set("");
    platformState.set("");
    franchiseState.set("");
    regionState.set("");
    mediaState.set("Física");
    conditionState.set("Usado");
    coverPathState.set("");
    requestRefresh();
    true;
};

var editGame << fct(event) {
    var game << editTargets[event["targetId"]];
    editingId.set(game["id"]);
    nameState.set(game["name"]);
    platformState.set(game["platform"]);
    franchiseState.set(game["franchise"]);
    regionState.set(game["region"]);
    mediaState.set(game["media"]);
    conditionState.set(game["condition"]);
    coverPathState.set(game["cover_path"]);
    statusState.set("Editando " + game["name"]);
    context.focus(nameInput);
};

var askDeleteGame << fct(event) {
    var game << deleteTargets[event["targetId"]];
    pendingDeleteId.set(game["id"]);
    pendingDeleteName.set(game["name"]);
    deleteModalState.set(true);
    context.focus(ui.find(context, "cancel-delete"));
};

var openCover << fct(event) {
    var game << coverTargets[event["targetId"]];
    if (sizeOf(game["cover_path"]) > 0) {
        coverPreviewNameState.set(game["name"]);
        coverPreviewPathState.set(game["cover_path"]);
        coverModalState.set(true);
        context.focus(ui.find(context, "close-cover-x"));
    }
};

var refreshCollection << fct(event) {
    event;
    ui.remove(gameList, "collection-empty");
    for oldGame in currentGames {
        ui.remove(gameList, "game-row-" + toString(oldGame["id"]));
    }

    var platformOptions << ["Todas as plataformas"];
    for platform in storage.platforms(db) { addToArrayEnd(platformOptions, platform); }
    ui.set(platformFilterSelect, "options", platformOptions);
    if (hasOption(platformOptions, platformFilterState.get())) { platformOptions; } else { platformFilterState.set("Todas as plataformas"); }

    var franchiseOptions << ["Todas as franquias"];
    for franchise in storage.franchises(db) { addToArrayEnd(franchiseOptions, franchise); }
    ui.set(franchiseFilterSelect, "options", franchiseOptions);
    if (hasOption(franchiseOptions, franchiseFilterState.get())) { franchiseOptions; } else { franchiseFilterState.set("Todas as franquias"); }

    currentGames << storage.list(
        db,
        searchState.get(),
        sortState.get(),
        filterValue(platformFilterState.get(), "Todas as plataformas"),
        filterValue(franchiseFilterState.get(), "Todas as franquias")
    );
    editTargets << {};
    deleteTargets << {};
    coverTargets << {};
    countState.set(toString(sizeOf(currentGames)) + " exibidos • " + toString(storage.count(db)) + " total");

    if (sizeOf(currentGames) == 0) {
        ui.add(gameList, ui.containerWith({"id": "collection-empty", "padding": 18, "align": "center"}, [
            ui.text("Nenhum jogo encontrado. Ajuste os filtros ou adicione o primeiro item.")
        ]));
    }

    for game in currentGames {
        var gameId << game["id"];
        var rowId << "game-row-" + toString(gameId);
        var editId << "edit-game-" + toString(gameId);
        var deleteId << "delete-game-" + toString(gameId);
        var coverId << "cover-game-" + toString(gameId);
        var franchiseLabel << game["franchise"];
        var details << "";
        if (sizeOf(franchiseLabel) == 0) { franchiseLabel << "Sem franquia"; }
        if (sizeOf(game["region"]) > 0) { details << game["region"]; }
        if (sizeOf(game["media"]) > 0) {
            if (sizeOf(details) > 0) { details << details + " • "; }
            details << details + game["media"];
        }
        if (sizeOf(game["condition"]) > 0) {
            if (sizeOf(details) > 0) { details << details + " • "; }
            details << details + game["condition"];
        }
        if (sizeOf(details) == 0) { details << "Sem detalhes adicionais"; }

        editTargets[editId] << game;
        deleteTargets[deleteId] << game;
        coverTargets[coverId] << game;

        var cardRow << ui.rowWith({"gap": 8, "align": "center", "height": 92, "minHeight": 92}, [
            ui.columnWith({"gap": 0, "grow": 1, "height": 80, "minHeight": 80, "justify": "start"}, [
                ui.textWith(game["name"], {"fontSize": 17, "fontWeight": "bold", "height": 40, "minHeight": 40, "wrapWidth": 310}),
                ui.textWith(game["platform"] + " • " + franchiseLabel, {"fontSize": 13, "color": "muted", "height": 20, "minHeight": 20}),
                ui.textWith(details, {"fontSize": 12, "color": "muted", "height": 20, "minHeight": 20})
            ]),
            ui.buttonWith({"id": coverId, "text": "Capa", "visible": sizeOf(game["cover_path"]) > 0, "width": 72, "minWidth": 72, "height": 36, "minHeight": 36, "onClick": openCover, "accessibilityLabel": "Abrir capa de " + game["name"]}),
            ui.buttonWith({"id": editId, "text": "Editar", "width": 76, "minWidth": 76, "height": 36, "minHeight": 36, "onClick": editGame, "accessibilityLabel": "Editar " + game["name"]}),
            ui.buttonWith({"id": deleteId, "text": "Excluir", "width": 76, "minWidth": 76, "height": 36, "minHeight": 36, "danger": true, "onClick": askDeleteGame, "accessibilityLabel": "Excluir " + game["name"]})
        ]);

        ui.add(gameList, ui.containerWith({
            "id": rowId,
            "border": true,
            "paddingLeft": 10,
            "paddingRight": 10,
            "paddingTop": 4,
            "paddingBottom": 8,
            "height": 108,
            "minHeight": 108
        }, [cardRow]));
    }

    if (headlessMode) {
        show("collection-ready");
        show(storage.count(db));
        application.quit();
    }
};

application.on("collection_collapse_sidebar", fct(event) {
    event;
    sidebarCollapsedState.set(true);
    sidebarExpandedVisibleState.set(false);
    sidebarCollapsedVisibleState.set(true);
});
application.on("collection_expand_sidebar", fct(event) {
    event;
    sidebarCollapsedState.set(false);
    sidebarExpandedVisibleState.set(true);
    sidebarCollapsedVisibleState.set(false);
    context.focus(nameInput);
});
application.on("collection_clear", fct(event) { event; clearForm(); });
application.on("collection_save", fct(event) { event; saveGame(); });
application.on("collection_pick_cover", fct(event) {
    event;
    var path << pickedPath({"title": "Escolha a capa local", "defaultPath": paths["home"], "multiple": false});
    if (sizeOf(path) > 0) { coverPathState.set(path); statusState.set("Capa local selecionada"); }
});
application.on("collection_open_data", fct(event) { event; dataModalState.set(true); context.focus(ui.find(context, "export-json")); });
application.on("collection_close_data", fct(event) { event; dataModalState.set(false); });
application.on("collection_open_stats", fct(event) {
    event;
    var result << storage.stats(db);
    var summary << result["summary"];
    statsTotalState.set(toString(summary["total"]));
    statsPlatformCountState.set(toString(summary["platforms"]));
    statsFranchiseCountState.set(toString(summary["franchises"]));
    statsMediaState.set("Física: " + toString(summary["physical"]) + " • Digital: " + toString(summary["digital"]));
    statsCoverCountState.set(toString(summary["covers"]));

    ui.clearChart(statsMediaChart);
    ui.pieChart(statsMediaChart, {
        "values": [summary["physical"], summary["digital"]],
        "labels": ["Física", "Digital"],
        "colors": ["#3867e8", "#e89b38"],
        "legend": true,
        "fontSize": 12
    });

    var topValues << [];
    var topLabels << [];
    var tableRows << [];
    for row in result["top_platforms"] {
        addToArrayEnd(topValues, row["total"]);
        addToArrayEnd(topLabels, row["platform"]);
        addToArrayEnd(tableRows, [row["platform"], toString(row["total"])]);
    }
    ui.clearChart(statsPlatformChart);
    ui.barChart(statsPlatformChart, {
        "values": topValues,
        "labels": topLabels,
        "colors": ["#3867e8", "#42a56b", "#e89b38", "#9b59b6", "#e05260"],
        "fontSize": 10,
        "gap": 10
    });
    ui.set(statsPlatformTable, "rows", tableRows);
    statsModalState.set(true);
    context.focus(ui.find(context, "close-stats-x"));
});
application.on("collection_close_stats", fct(event) { event; statsModalState.set(false); });
application.on("collection_close_cover", fct(event) {
    event;
    coverModalState.set(false);
    coverPreviewNameState.set("");
    coverPreviewPathState.set("");
});
application.on("collection_open_cover_external", fct(event) {
    event;
    var path << coverPreviewPathState.get();
    if (sizeOf(path) > 0) { desktop.openExternal(application, path); }
});
application.on("collection_cancel_delete", fct(event) { event; deleteModalState.set(false); pendingDeleteId.set(0); });
application.on("collection_confirm_delete", fct(event) {
    event;
    var id << pendingDeleteId.get();
    var name << pendingDeleteName.get();
    if (id > 0) {
        storage.remove(db, id);
        if (editingId.get() == id) { clearForm(); }
        statusState.set(name + " removido da coleção");
        notify(name + " foi removido", "normal");
    }
    deleteModalState.set(false);
    pendingDeleteId.set(0);
    requestRefresh();
});
application.on("collection_export_json", fct(event) {
    event;
    var path << pickedPath({"title": "Exportar coleção em JSON", "mode": "save", "save": true, "defaultPath": paths["home"] + "/minha-colecao-de-jogos.json"});
    if (sizeOf(path) > 0) {
        var result << exchange.exportJson(db, path);
        if (result["ok"]) { statusState.set("Coleção exportada em JSON"); notify("Exportação JSON concluída", "normal"); }
        else { statusState.set("Falha ao exportar JSON: " + result["error"]); notify("Falha na exportação JSON", "critical"); }
    }
});
application.on("collection_import_json", fct(event) {
    event;
    var path << pickedPath({"title": "Importar coleção em JSON", "defaultPath": paths["home"], "multiple": false});
    if (sizeOf(path) > 0) {
        var result << exchange.importJson(db, path);
        var message << importMessage(result);
        statusState.set(message); notify(message, "normal"); requestRefresh();
    }
});
application.on("collection_export_csv", fct(event) {
    event;
    var path << pickedPath({"title": "Exportar coleção em CSV", "mode": "save", "save": true, "defaultPath": paths["home"] + "/minha-colecao-de-jogos.csv"});
    if (sizeOf(path) > 0) {
        var result << exchange.exportCsv(db, path);
        if (result["ok"]) { statusState.set("Coleção exportada em CSV"); notify("Exportação CSV concluída", "normal"); }
        else { statusState.set("Falha ao exportar CSV: " + result["error"]); notify("Falha na exportação CSV", "critical"); }
    }
});
application.on("collection_import_csv", fct(event) {
    event;
    var path << pickedPath({"title": "Importar coleção em CSV", "defaultPath": paths["home"], "multiple": false});
    if (sizeOf(path) > 0) {
        var result << exchange.importCsv(db, path);
        var message << importMessage(result);
        statusState.set(message); notify(message, "normal"); requestRefresh();
    }
});
application.on("collection_backup", fct(event) {
    event;
    var path << pickedPath({"title": "Criar backup do banco", "mode": "save", "save": true, "defaultPath": paths["home"] + "/minha-colecao-de-jogos-backup.sqlite"});
    if (sizeOf(path) > 0) {
        var result << storage.backup(db, path);
        if (result["ok"]) { statusState.set("Backup criado com sucesso"); notify("Backup criado com sucesso", "normal"); }
        else { statusState.set("Falha no backup: " + result["error"]); notify("Falha ao criar backup", "critical"); }
    }
});
application.on("collection_choose_restore", fct(event) {
    event;
    var path << pickedPath({"title": "Escolha um backup SQLite", "defaultPath": paths["home"], "multiple": false});
    if (sizeOf(path) > 0) {
        pendingRestorePath.set(path);
        dataModalState.set(false);
        restoreModalState.set(true);
        context.focus(ui.find(context, "cancel-restore"));
    }
});
application.on("collection_cancel_restore", fct(event) { event; restoreModalState.set(false); pendingRestorePath.set(""); });
application.on("collection_confirm_restore", fct(event) {
    event;
    var sourcePath << pendingRestorePath.get();
    var safetyPath << paths["data"] + "/before-restore.sqlite";
    var safetyResult << storage.backup(db, safetyPath);
    if (safetyResult["ok"]) {
        var result << storage.restore(db, sourcePath);
        if (result["ok"]) {
            clearForm();
            statusState.set("Backup restaurado com sucesso");
            notify("Coleção restaurada com sucesso", "normal");
            requestRefresh();
        } else {
            statusState.set("Falha na restauração: " + result["error"]);
            notify("Falha ao restaurar o backup", "critical");
        }
    } else {
        statusState.set("Restauração cancelada: não foi possível criar o backup de segurança");
        notify("Restauração cancelada por segurança", "critical");
    }
    restoreModalState.set(false);
    pendingRestorePath.set("");
});
application.on("collection_refresh", refreshCollection);

searchState.subscribe(fct(value) { value; requestRefresh(); });
sortState.subscribe(fct(value) { value; savePreferences(); requestRefresh(); });
platformFilterState.subscribe(fct(value) { value; savePreferences(); requestRefresh(); });
franchiseFilterState.subscribe(fct(value) { value; savePreferences(); requestRefresh(); });
darkModeState.subscribe(fct(enabled) {
    if (enabled) { context.setTheme(ui.theme("dark")); } else { context.setTheme(ui.theme("light")); }
    savePreferences();
});

application.shortcut("Ctrl+N", fct(event) { event; clearForm(); });
application.shortcut("Ctrl+S", fct(event) { event; saveGame(); });
application.shortcut("Ctrl+F", fct(event) { event; context.focus(searchInput); });
application.shortcut("Ctrl+D", fct(event) { event; dataModalState.set(true); });
application.shortcut("Ctrl+T", fct(event) { event; application.emit({"type": "collection_open_stats", "data": {}}); });
application.shortcut("Ctrl+Q", fct(event) { event; application.quit(); });
application.shortcut("Escape", fct(event) {
    event;
    deleteModalState.set(false);
    dataModalState.set(false);
    restoreModalState.set(false);
    statsModalState.set(false);
    coverModalState.set(false);
});
application.shortcut("Tab", fct(event) { event; context.focusNext(false); });
application.shortcut("Shift+Tab", fct(event) { event; context.focusNext(true); });

requestRefresh();
window.show();
application.run();

storage.close(db);
context.close();
application.close();
